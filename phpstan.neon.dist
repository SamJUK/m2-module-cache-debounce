includes:
    - vendor/samjuk/dev-standards/php/magento/phpstan.neon

parameters:
    paths:
        - Console
        - Cron
        - Model
        - Plugin
        - Setup
        - Test
        - registration.php
    # Magento\TestFramework only exists inside a Magento install; CI runs these in the PHPUnit job.
    excludePaths:
        - Test/Integration
